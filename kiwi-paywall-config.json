{
  "paywall": {
    "id": "kiwi_pro_default",
    "name": "Kiwi Pro - Default Paywall",
    "type": "FULL_SCREEN",
    "template": "TEMPLATE_5",
    "design": {
      "colors": {
        "primary": "#1A535C",
        "accent": "#007AFF",
        "background": "#FFFFFF",
        "text_primary": "#2D3436",
        "text_secondary": "#6C757D",
        "success": "#22C55E",
        "card_background": "#F8F9FA"
      },
      "typography": {
        "font_family": "SF Pro",
        "title_size": 28,
        "subtitle_size": 17,
        "body_size": 15,
        "caption_size": 13
      },
      "spacing": {
        "padding": 24,
        "item_spacing": 16,
        "section_spacing": 32
      },
      "corner_radius": 16,
      "shadow_enabled": true
    },
    "content": {
      "header": {
        "icon": "🥝",
        "icon_size": 80,
        "title": "Unlock Kiwi Pro",
        "title_color": "#2D3436",
        "subtitle": "Empower unlimited communication with premium AAC features",
        "subtitle_color": "#6C757D",
        "background_gradient": [
          "#FFFFFF",
          "#F8F9FA"
        ]
      },
      "features": [
        {
          "icon": "✨",
          "title": "Unlimited Vocabulary",
          "description": "Break free from the 50-icon limit. Add unlimited custom buttons and folders.",
          "highlight": true
        },
        {
          "icon": "📸",
          "title": "Unlimited Custom Photos",
          "description": "Add unlimited custom photos from your camera roll or device.",
          "highlight": true
        },
        {
          "icon": "☁️",
          "title": "Cloud Backup & Sync",
          "description": "Sync boards across devices with a secure code. Never lose your vocabulary.",
          "highlight": false
        },
        {
          "icon": "👥",
          "title": "Multiple Profiles",
          "description": "Perfect for families, schools, and clinics. Unlimited profiles with personalized settings.",
          "highlight": false
        },
        {
          "icon": "📊",
          "title": "Advanced Analytics",
          "description": "View progress history beyond 7 days and track usage trends.",
          "highlight": false
        },
        {
          "icon": "🎨",
          "title": "Premium Themes",
          "description": "Personalize your experience with Ocean, Sunset, Forest, Berry, and Candy themes.",
          "highlight": false
        },
        {
          "icon": "🗣️",
          "title": "Custom Pronunciations",
          "description": "Unlock unlimited pronunciation overrides for clearer speech.",
          "highlight": false
        },
        {
          "icon": "🎭",
          "title": "Character Builder",
          "description": "Create unlimited personalized avatars for your Circle of Support.",
          "highlight": false
        }
      ],
      "social_proof": {
        "enabled": true,
        "text": "Join 10,000+ AAC users worldwide",
        "stars": 5,
        "rating_text": "4.9 out of 5 stars"
      },
      "pricing": {
        "header": "Choose Your Plan",
        "comparison_enabled": true,
        "packages": [
          {
            "identifier": "$rc_monthly",
            "product_id": "kiwi_monthly",
            "title": "Monthly",
            "badge": "Most Flexible",
            "badge_color": "#007AFF",
            "price_display": "$4.99",
            "billing_period": "per month",
            "description": "Cancel anytime",
            "features": [
              "All premium features",
              "Monthly billing",
              "Cancel anytime"
            ],
            "is_default": false,
            "highlight": false
          },
          {
            "identifier": "$rc_annual",
            "product_id": "kiwi_annual",
            "title": "Annual",
            "badge": "Best Value",
            "badge_color": "#22C55E",
            "price_display": "$39.99",
            "billing_period": "per year",
            "price_per_month": "$3.33/month",
            "savings_text": "Save 33%",
            "savings_amount": "$20/year",
            "description": "Best value for families",
            "features": [
              "All premium features",
              "Save $20 per year",
              "Best value"
            ],
            "is_default": true,
            "highlight": true
          },
          {
            "identifier": "$rc_lifetime",
            "product_id": "kiwi_lifetime",
            "title": "Lifetime",
            "badge": "One-Time Payment",
            "badge_color": "#111827",
            "price_display": "$149.99",
            "billing_period": "one-time",
            "description": "Pay once, keep forever",
            "features": [
              "All premium features",
              "One-time payment",
              "No recurring fees"
            ],
            "is_default": false,
            "highlight": false
          }
        ]
      },
      "free_trial": {
        "enabled": true,
        "duration": 7,
        "duration_unit": "days",
        "cta_text": "Start 7-Day Free Trial",
        "disclaimer": "Free for 7 days, then {{price}} per {{period}}. Cancel anytime."
      },
      "call_to_action": {
        "primary_button": {
          "text": "Start Free Trial",
          "background_color": "#1A535C",
          "text_color": "#FFFFFF",
          "corner_radius": 12,
          "height": 56,
          "shadow": true
        },
        "secondary_button": {
          "text": "Restore Purchases",
          "background_color": "transparent",
          "text_color": "#007AFF",
          "corner_radius": 12,
          "height": 44,
          "border_color": "#007AFF",
          "border_width": 2
        }
      },
      "footer": {
        "legal_links": [
          {
            "text": "Terms of Service",
            "url": "https://kiwivoiceapp.com/terms"
          },
          {
            "text": "Privacy Policy",
            "url": "https://kiwivoiceapp.com/privacy"
          },
          {
            "text": "Support",
            "url": "mailto:support@kiwivoiceapp.com"
          }
        ],
        "disclaimer": "Subscription automatically renews unless cancelled at least 24 hours before the end of the current period. Manage subscriptions in Settings.",
        "text_color": "#6C757D",
        "font_size": 12
      }
    },
    "localization": {
      "default_language": "en",
      "supported_languages": [
        "en",
        "es"
      ],
      "translations": {
        "es": {
          "header": {
            "title": "Desbloquea Kiwi Pro",
            "subtitle": "Potencia la comunicación ilimitada con funciones AAC premium"
          },
          "features": [
            {
              "title": "Vocabulario Ilimitado",
              "description": "Libérate del límite de 50 iconos. Agrega botones y carpetas personalizados ilimitados."
            },
            {
              "title": "Fotos Personalizadas Ilimitadas",
              "description": "Agrega fotos personalizadas ilimitadas desde tu dispositivo."
            },
            {
              "title": "Copia de Seguridad en la Nube",
              "description": "Sincroniza tableros entre dispositivos con un código seguro."
            },
            {
              "title": "Múltiples Perfiles",
              "description": "Perfecto para familias, escuelas y clínicas. Perfiles ilimitados con configuraciones personalizadas."
            },
            {
              "title": "Análisis Avanzados",
              "description": "Ve el historial de progreso más allá de 7 días."
            },
            {
              "title": "Temas Premium",
              "description": "Personaliza tu experiencia con temas Océano, Atardecer, Bosque, Mora y Dulce."
            },
            {
              "title": "Pronunciaciones Personalizadas",
              "description": "Desbloquea pronunciaciones ilimitadas para un habla más clara."
            },
            {
