          },
          "free_trial": {
            "cta_text": "Comenzar Prueba Gratis de 7 Días"
          },
          "call_to_action": {
            "primary_button": {
              "text": "Comenzar Prueba Gratis"
            },
            "secondary_button": {
              "text": "Restaurar Compras"
            }
          }
        }
      }
    },
    "targeting": {
      "audiences": [
        {
          "name": "New Users (0-7 days)",
          "conditions": {
            "days_since_install": {
              "min": 0,
              "max": 7
            }
          },
          "variant": "emphasis_free_trial"
        },
        {
          "name": "Engaged Users (7+ days)",
          "conditions": {
            "days_since_install": {
              "min": 7
            },
            "session_count": {
              "min": 5
            }
          },
          "variant": "emphasis_value"
        },
        {
          "name": "Hit Free Limit",
          "conditions": {
            "custom_attribute": "vocabulary_count",
            "operator": ">=",
            "value": 50
          },
          "variant": "emphasis_unlimited"
        }
      ]
    },
    "analytics": {
      "track_impressions": true,
      "track_conversions": true,
      "track_dismissals": true,
      "custom_events": [
        "paywall_viewed",
        "paywall_dismissed",
        "paywall_purchased_monthly",
        "paywall_purchased_annual",
        "paywall_trial_started",
        "paywall_restore_attempted"
      ]
    }
  },
  "paywall_variants": [
    {
      "id": "emphasis_free_trial",
      "name": "Emphasis on Free Trial",
      "changes": {
        "content.header.title": "Try Kiwi Pro Free",
        "content.header.subtitle": "7 days free, then unlock unlimited AAC features",
        "content.call_to_action.primary_button.text": "Start Free Trial Now"
      }
    },
    {
      "id": "emphasis_value",
      "name": "Emphasis on Value",
      "changes": {
        "content.header.title": "Save 33% with Annual Plan",
        "content.header.subtitle": "Get unlimited features for less than $4/month",
        "content.pricing.packages[1].highlight": true
      }
    },
    {
      "id": "emphasis_unlimited",
      "name": "Emphasis on Unlimited",
      "changes": {
        "content.header.title": "Go Unlimited",
        "content.header.subtitle": "Break free from limits. Unlimited vocabulary, photos, and profiles.",
        "content.features[0].highlight": true
      }
    }
  ],
  "metadata": {
    "created_by": "Claude Code",
    "created_at": "2026-01-04",
    "version": "1.0",
    "app_name": "Kiwi AAC",
    "template_based_on": "RevenueCat Template 5 (Full Screen)",
    "notes": "Optimized for AAC users and families. Emphasizes communication empowerment and unlimited features."
  }
}
