    "footer_section": {
      "enabled": true,
      "legal_links": {
        "enabled": true,
        "links": [
          {
            "text": "Terms of Service",
            "url": "https://kiwivoiceapp.com/terms"
          },
          {
            "text": "Privacy Policy",
            "url": "https://kiwivoiceapp.com/privacy"
          },
          {
