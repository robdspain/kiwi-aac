        "color": "#6C757D",
        "line_height": 1.5,
        "alignment": "center",
        "padding_top": 16
      }
    },

    "design_system": {
      "colors": {
        "primary": "#1A535C",
        "accent": "#007AFF",
        "success": "#22C55E",
        "background": "#FFFFFF",
        "surface": "#F8F9FA",
        "text_primary": "#2D3436",
        "text_secondary": "#6C757D",
        "border": "#E5E5EA"
      },
      "typography": {
        "font_family": "SF Pro",
        "scale": {
          "title": 28,
          "heading": 20,
          "subheading": 17,
          "body": 15,
          "caption": 13,
          "small": 12
        },
        "weights": {
          "bold": 700,
          "semibold": 600,
          "regular": 400
        }
      },
      "spacing": {
        "unit": 4,
        "padding_horizontal": 24,
        "padding_vertical": 24,
        "section_spacing": 32,
        "item_spacing": 16,
        "compact_spacing": 8
      },
      "corner_radius": {
        "small": 8,
        "medium": 12,
        "large": 16,
        "extra_large": 24
      },
      "shadows": {
        "small": {
          "offset_y": 2,
          "blur": 8,
          "opacity": 0.1
        },
        "medium": {
          "offset_y": 4,
          "blur": 12,
          "opacity": 0.15
        },
        "large": {
          "offset_y": 8,
          "blur": 24,
          "opacity": 0.2
        }
      }
    },

    "layout": {
      "max_width": 600,
      "padding": 24,
      "safe_area_insets": true,
      "scroll_enabled": true
    }
  },

