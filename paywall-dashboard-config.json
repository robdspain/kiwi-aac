          "border_color": "#007AFF",
          "border_width": 3,
          "corner_radius": 16,
          "shadow": {
            "enabled": true,
            "color": "#007AFF",
            "opacity": 0.2,
            "offset_x": 0,
            "offset_y": 4,
            "blur_radius": 12
          }
        }
      ],
      "card_spacing": 16,
      "padding": 16
