  "targeting": {
    "audiences": [
      {
        "name": "New Users (0-7 days)",
        "conditions": {
          "days_since_install": {
            "min": 0,
            "max": 7
          }
        },
        "variant_overrides": {
          "header": {
            "title": "Try Kiwi Pro Free",
            "subtitle": "7 days free, then unlock unlimited AAC features"
          },
          "cta": {
            "primary": "Start Free Trial Now"
          }
        }
      },
      {
        "name": "Engaged Users (7+ days)",
        "conditions": {
          "days_since_install": {
            "min": 7
          },
          "session_count": {
            "min": 5
          }
        },
        "variant_overrides": {
          "header": {
            "title": "Save 33% with Annual Plan",
            "subtitle": "Get unlimited features for less than $7/month"
          }
        }
      },
      {
        "name": "Users at Free Limit",
        "conditions": {
          "custom_attribute": "vocabulary_count",
          "operator": ">=",
          "value": 50
        },
        "variant_overrides": {
          "header": {
            "title": "Go Unlimited",
            "subtitle": "Break free from limits. Unlimited vocabulary, photos, and profiles."
          }
        }
      }
    ]
  },

  "analytics": {
    "track_impressions": true,
    "track_conversions": true,
    "track_dismissals": true,
    "custom_events": [
      "paywall_viewed",
      "paywall_dismissed",
      "paywall_monthly_selected",
      "paywall_annual_selected",
      "paywall_trial_started",
      "paywall_purchased",
      "paywall_restore_attempted"
    ]
  },

  "metadata": {
    "created_by": "Kiwi AAC Team",
    "created_at": "2026-01-04",
    "version": "1.0.0",
    "notes": "Optimized for AAC users and families. Emphasizes communication empowerment and unlimited features."
  }
}
